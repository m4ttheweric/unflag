{
  "name": "@m4ttheweric/eslint-plugin-unflag",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/m4ttheweric/unflag.git",
    "directory": "packages/eslint-plugin-unflag"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": { "picomatch": "^4.0.2" },
  "peerDependencies": { "eslint": ">=9" },
  "devDependencies": {
    "@types/picomatch": "^3.0.1",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
